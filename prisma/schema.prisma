// Rock One Square — Prisma Schema
// Database: MongoDB
// ORM: Prisma 6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

// Roles: "admin" | "superadmin" | "content_manager"
model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String    @unique
  password    String    // bcrypt hash, never plaintext
  role        String    @default("admin")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions  Session[]
  leadNotes LeadNote[]
  auditLogs AuditLog[]

  @@map("users")
}

// Server-side session record — used to revoke tokens on logout / disable
model Session {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  tokenFamily String   // refresh-token rotation family ID
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  action     String   // "CREATE_BANNER", "UPDATE_LEAD", "DISABLE_USER", etc.
  entityType String   // "Banner", "Enquiry", "User", etc.
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// PROJECT
// ============================================================

// status: "DRAFT" | "PUBLISHED" | "ARCHIVED"
model Project {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  slug              String  @unique
  name              String
  tagline           String?
  description       String?
  developerName     String  @default("Senflore Hospitality LLP")
  address           String?
  city              String?
  state             String?
  country           String  @default("India")
  pincode           String?
  latitude          Float?
  longitude         Float?
  siteAreaAcres     Float?
  builtUpAreaSqm    Float?
  roadFrontageMtr   Float?
  totalFloors       Int?
  completedFloors   Int?
  constructionStatus String?
  status            String  @default("DRAFT")
  featuredImage     String?
  metaTitle         String?
  metaDescription   String?
  ogImage           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  offerings           Offering[]
  floors              Floor[]
  banners             Banner[]
  constructionUpdates ConstructionUpdate[]
  enquiries           Enquiry[]
  faqs                FAQ[]
  amenityLinks        ProjectAmenity[]

  @@index([status])
  @@map("projects")
}

// ============================================================
// COMMERCIAL OFFERINGS
// ============================================================

// type: "RETAIL" | "ENTERTAINMENT" | "OFFICE" | "STUDIO_APARTMENT" | "HOTEL" | "DINING" | "OTHER"
// status: "DRAFT" | "PUBLISHED" | "ARCHIVED"
model Offering {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  slug        String
  type        String
  title       String
  shortDesc   String?
  description String?
  iconName    String?
  coverImage  String?
  galleryUrls String[] @default([])
  floorInfo   String?
  highlights  String[] @default([])
  sortOrder   Int      @default(0)
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId, status])
  @@map("offerings")
}

// ============================================================
// FLOORS
// ============================================================

// status: "DRAFT" | "PUBLISHED" | "ARCHIVED"
model Floor {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String   @db.ObjectId
  floorNumber  Int
  floorLabel   String
  shortLabel   String?
  offeringType String?
  description  String?
  imageUrls    String[] @default([])
  highlights   String[] @default([])
  sortOrder    Int      @default(0)
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, floorNumber])
  @@index([projectId, status])
  @@map("floors")
}

// ============================================================
// AMENITIES
// ============================================================

model Amenity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  iconName    String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectLinks ProjectAmenity[]

  @@map("amenities")
}

model ProjectAmenity {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  projectId String @db.ObjectId
  amenityId String @db.ObjectId
  sortOrder Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([projectId, amenityId])
  @@map("project_amenities")
}

// ============================================================
// BANNERS / HERO CAROUSEL
// ============================================================

// status: "DRAFT" | "PUBLISHED" | "ARCHIVED"
model Banner {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String?  @db.ObjectId
  title             String
  subtitle          String?
  description       String?
  imageUrl          String?
  mobileImageUrl    String?
  ctaLabel          String?
  ctaUrl            String?
  secondaryCtaLabel String?
  secondaryCtaUrl   String?
  badge             String?
  sortOrder         Int      @default(0)
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, status, sortOrder])
  @@map("banners")
}

// ============================================================
// CONSTRUCTION UPDATES
// ============================================================

model ConstructionUpdate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId       String   @db.ObjectId
  title           String
  description     String?
  updateDate      DateTime
  floorsCompleted Int?
  overallProgress Int?     // 0-100 percentage
  isMilestone     Boolean  @default(false)
  milestoneLabel  String?
  photoUrls       String[] @default([])
  isPublished     Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isPublished])
  @@index([updateDate])
  @@map("construction_updates")
}

// ============================================================
// FAQ
// ============================================================

model FAQ {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String?  @db.ObjectId
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, isPublished])
  @@map("faqs")
}

// ============================================================
// ENQUIRIES / LEADS
// ============================================================

// enquiryType: "GENERAL" | "SITE_VISIT" | "CALLBACK" | "BROCHURE" | "RETAIL" | "OFFICE" | "STUDIO" | "OTHER"
// source:      "WEBSITE" | "WHATSAPP" | "PHONE" | "REFERRAL" | "WALK_IN" | "DIGITAL_AD" | "OTHER"
// status:      "NEW" | "CONTACTED" | "FOLLOW_UP" | "SITE_VISIT_SCHEDULED" | "INTERESTED" | "CONVERTED" | "CLOSED" | "NOT_INTERESTED"
model Enquiry {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  referenceId      String    @unique
  projectId        String?   @db.ObjectId
  offeringType     String?
  fullName         String
  phone            String
  email            String?
  countryCode      String    @default("+91")
  enquiryType      String
  message          String?
  preferredDate    DateTime?
  preferredTime    String?
  source           String    @default("WEBSITE")
  sourcePage       String?
  status           String    @default("NEW")
  consentGiven     Boolean   @default(false)
  consentTimestamp DateTime?
  ipAddress        String?
  userAgent        String?
  followUpDate     DateTime?
  isArchived       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes   LeadNote[]

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([projectId])
  @@map("enquiries")
}

model LeadNote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  enquiryId  String   @db.ObjectId
  userId     String   @db.ObjectId
  note       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@map("lead_notes")
}

// ============================================================
// SITE SETTINGS (Key-Value store)
// ============================================================

model SiteSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String?
  label     String?
  group     String?
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}
