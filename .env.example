# Rock One Square — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to version control.

# ============================
# DATABASE (MongoDB)
# ============================
# Get from MongoDB Atlas > Connect > Drivers
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rock_one_square?retryWrites=true&w=majority"

# ============================
# AUTHENTICATION (Auth.js / NextAuth)
# ============================
# Generate with: openssl rand -hex 32
AUTH_SECRET="<64-char random hex string>"
NEXTAUTH_URL="http://localhost:3000"

# ============================
# SUPERADMIN BOOTSTRAP
# ============================
# Used ONLY by: pnpm db:seed:superadmin (run once, then remove password!)
SUPERADMIN_BOOTSTRAP_EMAIL="superadmin@yourdomain.com"
SUPERADMIN_BOOTSTRAP_PASSWORD="<strong-password-min-12-chars>"
SUPERADMIN_BOOTSTRAP_NAME="Super Administrator"

# ============================
# EMAIL NOTIFICATIONS (Resend)
# ============================
# Sign up at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender email address
EMAIL_FROM="noreply@yourdomain.com"
# Sales team email for lead notifications
SALES_EMAIL="sales@rockonesquare.com"

# ============================
# IMAGE & FILE STORAGE (Cloudinary — optional)
# ============================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_UPLOAD_PRESET="rock_one_square"

# ============================
# WHATSAPP
# ============================
# WhatsApp Business number (with country code, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"

# Optional: WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ============================
# GOOGLE MAPS (optional)
# ============================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_MAP_LAT="28.6765"
NEXT_PUBLIC_MAP_LNG="77.4369"

# ============================
# SITE CONFIGURATION
# ============================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PROJECT_NAME="Rock One Square"
NEXT_PUBLIC_SALES_PHONE="+91XXXXXXXXXX"
NEXT_PUBLIC_SALES_EMAIL="sales@rockonesquare.com"

# ============================
# RATE LIMITING (optional — in-memory fallback used if unset)
# ============================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
